# 复制为 .env 并填入密钥。run 命令会自动加载 .env。

# OpenAI 兼容端点（按需保留）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...

# 官方 OpenAI（注意不要和上面的代理变量混用）
# OPENAI_OFFICIAL_API_KEY=sk-...

# 智谱 GLM-4V
# ZHIPUAI_API_KEY=...

# 阿里通义 Qwen-VL
# DASHSCOPE_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...
